# ═══════════════════════════════════════════════════════════
# QRMATE BACKEND ENVIRONMENT VARIABLES
# ═══════════════════════════════════════════════════════════

# Database connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/qrmate"

# JWT Secret for authentication
JWT_SECRET="supersecret_qrmate_key_please_change_in_prod"

# Redis connection for BullMQ
REDIS_URL="redis://127.0.0.1:6379"

# Email Service (Resend)
RESEND_API_KEY="re_..."

# Broadcasts & Marketing (Loops)
LOOPS_API_KEY="loops_..."

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Frontends
LANDING_PAGE_URL="http://localhost:3000"
USER_DASHBOARD_URL="http://localhost:3001"
